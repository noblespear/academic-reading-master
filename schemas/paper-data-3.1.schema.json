{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paper-data-3.1.schema.json",
  "title": "Reader v3.1 authoring contract (deployment also checks semantic gates)",
  "type": "object",
  "required": [
    "schema_version",
    "content_contract_version",
    "content_version",
    "content_status",
    "id",
    "content_review",
    "learning_catalog",
    "overview",
    "explanation",
    "sections"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "content_contract_version": {
      "const": "3.1"
    },
    "content_version": {
      "type": "string",
      "minLength": 1
    },
    "content_status": {
      "enum": [
        "incomplete",
        "ready"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
    },
    "title_en": {
      "type": "string"
    },
    "title_cn": {
      "type": "string"
    },
    "content_review": {
      "type": "object",
      "required": [
        "reviewer",
        "factual_gates"
      ],
      "properties": {
        "reviewer": {
          "type": "string"
        },
        "plain_language_scores": {
          "description": "Optional historical review scores; retained for compatibility, with no required total or deployment threshold. When present, record ten integer scores of 0, 1 or 2.",
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2
          }
        },
        "factual_gates": {
          "type": "object",
          "required": [
            "source_accuracy",
            "evidence_separation",
            "claim_scope",
            "prerequisites",
            "formula_correctness",
            "analogy_and_example"
          ],
          "properties": {
            "source_accuracy": {
              "type": "boolean"
            },
            "evidence_separation": {
              "type": "boolean"
            },
            "claim_scope": {
              "type": "boolean"
            },
            "prerequisites": {
              "type": "boolean"
            },
            "formula_correctness": {
              "type": "boolean"
            },
            "analogy_and_example": {
              "type": "boolean"
            }
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "learning_requirements": {
      "type": "object",
      "properties": {
        "overview_framework": {
          "description": "Optional additive registration of a default-visible top-level overview method framework. New scaffolds declare kind interactive_pipeline, requiring a placement body method_pipeline aid; static figures cannot satisfy it. Registrations without kind retain legacy figure/diagram and graph_walkthrough compatibility. Complete method coverage and agreement with prose require human review.",
          "type": "object",
          "required": [
            "section_id",
            "block_id"
          ],
          "properties": {
            "section_id": {
              "$ref": "content-types.schema.json#/$defs/id"
            },
            "block_id": {
              "$ref": "content-types.schema.json#/$defs/id"
            },
            "kind": {
              "const": "interactive_pipeline",
              "description": "When present, require the generic clickable directed method map. Omit only for pre-existing registrations."
            }
          }
        },
        "required_concept_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
          }
        },
        "required_formula_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
          }
        }
      }
    },
    "learning_catalog": {
      "type": "object",
      "required": [
        "concepts",
        "aids"
      ],
      "properties": {
        "concepts": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "content-types.schema.json#/$defs/concept"
          }
        },
        "aids": {
          "type": "array",
          "items": {
            "$ref": "content-types.schema.json#/$defs/aid"
          }
        }
      }
    },
    "overview": {
      "type": "object",
      "required": [
        "sections"
      ],
      "properties": {
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "blocks"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
              },
              "title_cn": {
                "type": "string"
              },
              "title_en": {
                "type": "string"
              },
              "page": {
                "type": "integer",
                "minimum": 1
              },
              "blocks": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "allOf": [
                    {
                      "$ref": "content-types.schema.json#/$defs/block"
                    },
                    {
                      "required": [
                        "evidence_kind"
                      ],
                      "properties": {
                        "learning": {
                          "$ref": "content-types.schema.json#/$defs/learning"
                        },
                        "key_formula": {
                          "type": "boolean"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "explanation": {
      "type": "object",
      "required": [
        "sections"
      ],
      "properties": {
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "blocks"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
              },
              "title_cn": {
                "type": "string"
              },
              "title_en": {
                "type": "string"
              },
              "page": {
                "type": "integer",
                "minimum": 1
              },
              "blocks": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "allOf": [
                    {
                      "$ref": "content-types.schema.json#/$defs/block"
                    },
                    {
                      "required": [
                        "evidence_kind"
                      ],
                      "properties": {
                        "learning": {
                          "$ref": "content-types.schema.json#/$defs/learning"
                        },
                        "key_formula": {
                          "type": "boolean"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "blocks"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
          },
          "title_cn": {
            "type": "string"
          },
          "title_en": {
            "type": "string"
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "blocks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "allOf": [
                {
                  "allOf": [
                    {
                      "$ref": "content-types.schema.json#/$defs/block"
                    },
                    {
                      "required": [
                        "evidence_kind"
                      ],
                      "properties": {
                        "learning": {
                          "$ref": "content-types.schema.json#/$defs/learning"
                        },
                        "key_formula": {
                          "type": "boolean"
                        }
                      }
                    }
                  ]
                },
                {
                  "not": {
                    "required": [
                      "learning"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "enum": [
                          "para",
                          "paragraph"
                        ]
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "text_en",
                      "text_zh"
                    ],
                    "properties": {
                      "text_en": {
                        "type": "string",
                        "minLength": 1
                      },
                      "text_zh": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                },
                {
                  "not": {
                    "required": [
                      "placement"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    "default_annotations": {
      "$ref": "content-types.schema.json#/$defs/defaultAnnotation"
    }
  }
}
