        "evidence_kind": "teaching_example",
        "config": {
          "initial_step": 0,
          "steps": [
            {
              "title": "读完C",
              "text": "第3步后，顺序为A B C，A最久没有使用。"
            },
            {
              "title": "再次读取A",
              "text": "第4步命中A，并将它记为刚用过。顺序变为B C A。"
            },
            {
              "title": "读取D",
              "text": "第5步需要D，但三个位置已满。此刻B最久没用，因此移出B，留下C A D。"
            }
          ]
        },
        "fallback_text": "第3步是A B C；第4步读取A后是B C A；第5步读取D时移出B，得到C A D。读取命中的项也会更新使用时间。"
      },
