  "learning_catalog": {
    "concepts": [
      {
        "id": "data",
        "label": "数据",
        "context_meaning": "本例要取用的一项内容，用A、B、C、D命名。",
        "plain_definition": "把每项内容看成一本有名字的书。字母只是名字，不表示数值。",
        "prerequisite_ids": []
      },
      {
        "id": "read",
        "label": "读取",
        "context_meaning": "取出当前需要的那项内容。",
        "plain_definition": "请求A，就是此刻要用A。是否已经放在缓存中，不影响这个请求叫什么。",
        "prerequisite_ids": [
          "data"
        ]
      },
      {
        "id": "capacity",
        "label": "容量",
        "context_meaning": "缓存最多能同时放几项数据。",
        "plain_definition": "本例容量为3，就是最多有三个位置。第四项到来时可能要腾位置。",
        "prerequisite_ids": [
          "data"
        ]
      },
      {
        "id": "hit",
        "label": "命中",
        "context_meaning": "要读取的内容已经在缓存里。",
        "plain_definition": "要用A时，A已经在桌上，这次就不用去书架取。",
        "prerequisite_ids": [
          "read"
        ]
      },
      {
        "id": "miss",
        "label": "未命中",
        "context_meaning": "要读取的内容不在缓存里，需要从外部取来。",
        "plain_definition": "要用B时桌上没有B，需要去书架取。即使桌上还有空位，也算未命中。",
        "prerequisite_ids": [
          "hit"
        ]
      },
      {
        "id": "evict",
        "label": "移出",
        "context_meaning": "从缓存拿走一项，为新内容腾位置。",
        "plain_definition": "把一本书从桌面放回书架。外部原件仍保留，移出不表示内容永远消失。",
        "prerequisite_ids": [
          "capacity"
        ]
      },
      {
        "id": "lru",
        "label": "最近最少使用（LRU）",
        "context_meaning": "位置满了时，移出最久没有被用过的那项。",
        "plain_definition": "每用一次，就记下它刚用过。需要腾位置时，选最后一次使用时间最早的那项。",
        "prerequisite_ids": [
          "read",
          "evict"
        ]
      },
      {
        "id": "ratio",
        "label": "比例",
        "context_meaning": "一类情况的次数，占总次数的多少。",
        "plain_definition": "七次读取里有两次命中，就用2除以7。比例没有单位，可写成小数或百分比。",
        "prerequisite_ids": [
          "hit",
          "read"
        ]
      }
    ],
