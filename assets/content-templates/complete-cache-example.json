      },
      {
        "id": "aid-predict",
        "type": "prediction",
        "version": 1,
        "title": "先预测第5步",
        "evidence_kind": "teaching_example",
        "config": {
          "question": "第4步刚用过A。第5步读取D时，缓存B C A中会移出哪项？",
